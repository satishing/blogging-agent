OPENROUTER_API_KEY=replace_me
SERPER_API_KEY=replace_me
DEVTO_API_KEY=replace_me_if_publishing
API_AUTH_KEY=replace_with_a_long_random_key

# Optional defaults
MODEL_NAME=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CACHE_BACKEND=file
REDIS_URL=redis://localhost:6379/0
PUBLISH_AS_DRAFT=true
LOG_LEVEL=INFO
API_AUTH_ENABLED=true
API_AUTH_HEADER_NAME=X-API-Key
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=30
API_RATE_LIMIT_WINDOW_SECONDS=60

# Telemetry — the app opts out of CrewAI/OTEL telemetry by default at import
# time. Set these to "false" only if you deliberately want telemetry back on.
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
